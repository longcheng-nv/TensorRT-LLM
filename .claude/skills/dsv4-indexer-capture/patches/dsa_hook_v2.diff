+# === Q9j capture hook v2 (env-gated; default OFF) ============================
+# Captures real-loop DSV4 indexer streams. Backward compatible: with only
+# DSV4_INDEXER_CAPTURE_DIR set, behavior == hook v1 (decode-side
+# logits.in/preidx.in/topk.out + prefill topk_indices_buffer snapshot in
+# legacy single-file `q9j_*.pt` layout).
+#
+# Streams (per layer):
+#   - prefill.logits.in (fp32, [num_q, kv_len])  BEFORE prefill indexer
+#                                                 keyed by (layer, chunk_idx)
+#   - prefill.topk.out  (int32, [num_ctx, K])    AFTER prefill block (legacy)
+#                                                 keyed by layer
+#   - decode.logits.in  (fp32, [kv_len])         BEFORE indexer_topk_decode
+#                                                 keyed by (layer, step)
+#   - decode.preidx.in  (int32, [K])             BEFORE indexer_topk_decode
+#                                                 keyed by (layer, step)
+#   - decode.topk.out   (int32, [K])             AFTER  indexer_topk_decode
+#                                                 keyed by (layer, step)
+#
+# Env vars:
+#   DSV4_INDEXER_CAPTURE_DIR     = /path/to/out      (REQUIRED — gates hook)
+#   DSV4_INDEXER_CAPTURE_LAYERS  = "2,4,6,..."       (default Flash 2..42 even)
+#   DSV4_INDEXER_CAPTURE_PHASE   = prefill|decode|both   (default decode for
+#                                                         v1-compat; the new
+#                                                         driver sets `both`)
+#   DSV4_INDEXER_CAPTURE_LAYOUT  = single-file|per-layer (default single-file)
+#   DSV4_INDEXER_CAPTURE_FORMAT  = pt|npz                (default pt)
+import os as _q9j_os
+import atexit as _q9j_atexit
+
+_Q9J_CAPTURE_DIR = _q9j_os.environ.get("DSV4_INDEXER_CAPTURE_DIR")
+_Q9J_LAYERS_TO_LOG_DEFAULT = tuple(range(2, 43, 2))  # 21 Flash GVR-active layers
+_Q9J_LAYERS_TO_LOG_ENV = _q9j_os.environ.get("DSV4_INDEXER_CAPTURE_LAYERS")
+if _Q9J_LAYERS_TO_LOG_ENV:
+    _Q9J_LAYERS_TO_LOG = tuple(
+        int(x) for x in _Q9J_LAYERS_TO_LOG_ENV.split(",") if x.strip())
+else:
+    _Q9J_LAYERS_TO_LOG = _Q9J_LAYERS_TO_LOG_DEFAULT
+
+_Q9J_PHASE = (_q9j_os.environ.get("DSV4_INDEXER_CAPTURE_PHASE") or "both").lower()
+if _Q9J_PHASE not in ("prefill", "decode", "both"):
+    raise ValueError(f"DSV4_INDEXER_CAPTURE_PHASE must be prefill|decode|both, got {_Q9J_PHASE}")
+_Q9J_DO_DECODE = _Q9J_PHASE in ("decode", "both")
+_Q9J_DO_PREFILL = _Q9J_PHASE in ("prefill", "both")
+_Q9J_LAYOUT = (_q9j_os.environ.get("DSV4_INDEXER_CAPTURE_LAYOUT") or "single-file").lower()
+_Q9J_FORMAT = (_q9j_os.environ.get("DSV4_INDEXER_CAPTURE_FORMAT") or "pt").lower()
+if _Q9J_FORMAT not in ("pt", "npz"):
+    raise ValueError(f"DSV4_INDEXER_CAPTURE_FORMAT must be pt or npz, got {_Q9J_FORMAT}")
+if _Q9J_LAYOUT not in ("single-file", "per-layer"):
+    raise ValueError(f"DSV4_INDEXER_CAPTURE_LAYOUT must be single-file or per-layer, got {_Q9J_LAYOUT}")
+
+_q9j_buf = {  # {stream: {(layer_idx, step|chunk_idx): cpu_tensor}}
+    "logits.in":         {},  # decode (v1 name)
+    "preidx.in":         {},  # decode (v1 name)
+    "topk.out":          {},  # decode (v1 name)
+    "prefill.logits.in": {},  # new in v2
+}
+# Legacy prefill topk snapshot keyed by layer only.
+_q9j_prefill_buf = {}  # {layer_idx: cpu_tensor of shape (num_ctx_tokens, K)}
+_q9j_state = {
+    "step": -1,
+    "layers_seen": set(),
+    "flushed": False,
+}
+
+
+def _q9j_maybe_new_step(layer_idx: int) -> int:
+    """Advance decode-step counter on repeated layer (closed-loop detection)."""
+    s = _q9j_state
+    if layer_idx in s["layers_seen"] or len(s["layers_seen"]) == 0:
+        s["step"] += 1
+        s["layers_seen"] = {layer_idx}
+    else:
+        s["layers_seen"].add(layer_idx)
+    return s["step"]
+
+
+def _q9j_is_rank0(metadata) -> bool:
+    mapping = getattr(metadata, "mapping", None)
+    if mapping is None:
+        return True
+    return getattr(mapping, "tp_rank", 0) == 0
+
+
+def _q9j_log(stream: str, layer_idx: int, step: int, t) -> None:
+    if t is None or layer_idx not in _Q9J_LAYERS_TO_LOG:
+        return
+    if torch.cuda.is_current_stream_capturing():
+        return
+    _q9j_buf[stream][(layer_idx, step)] = t.detach().cpu().contiguous()
+
+
+def _q9j_log_prefill_logits(layer_idx: int, chunk_idx: int, t) -> None:
+    """Capture prefill `logits` tensor (output of MQA logits, input to
+    indexer_topk_prefill). Shape [num_q_in_chunk, kv_len_chunk] for chunked
+    prefill, or [num_ctx, num_ctx_kv] for single-pass fallback."""
+    if not _Q9J_DO_PREFILL:
+        return
+    if t is None or layer_idx not in _Q9J_LAYERS_TO_LOG:
+        return
+    if torch.cuda.is_current_stream_capturing():
+        return
+    _q9j_buf["prefill.logits.in"][(layer_idx, chunk_idx)] = (
+        t.detach().cpu().contiguous())
+
+
+def _q9j_log_prefill(layer_idx: int, t) -> None:
+    """Snapshot topk_indices_buffer[:num_ctx_tokens, :] after prefill (v1)."""
+    if t is None or layer_idx not in _Q9J_LAYERS_TO_LOG:
+        return
+    if torch.cuda.is_current_stream_capturing():
+        return
+    if not (t >= 0).any():
+        return  # all-sentinel warmup
+    _q9j_prefill_buf[layer_idx] = t.detach().cpu().contiguous()
+
+
+def _q9j_save_dict(dct, path_no_ext: str) -> str:
+    """Save a dict[key -> tensor] to .pt or .npz based on _Q9J_FORMAT.
+    Returns the full path written.
+    """
+    if _Q9J_FORMAT == "pt":
+        path = path_no_ext + ".pt"
+        torch.save(dct, path)
+    else:  # npz
+        import numpy as _np
+        path = path_no_ext + ".npz"
+        # Tuple keys -> "L<l>_S<s>" / scalar key -> "L<l>"
+        arr = {}
+        for k, v in dct.items():
+            if isinstance(k, tuple):
+                arr[f"L{k[0]}_S{k[1]}"] = v.numpy()
+            else:
+                arr[f"L{k}"] = v.numpy()
+        _np.savez(path, **arr)
+    return path
+
+
+def _q9j_flush() -> None:
+    if _q9j_state["flushed"] or not _Q9J_CAPTURE_DIR:
+        return
+    _q9j_os.makedirs(_Q9J_CAPTURE_DIR, exist_ok=True)
+
+    if _Q9J_LAYOUT == "single-file":
+        # v1-compat: one file per stream
+        STREAM_TO_FILE = {
+            "logits.in":         "q9j_logits.in",           # decode
+            "preidx.in":         "q9j_preidx.in",           # decode
+            "topk.out":          "q9j_topk.out",            # decode
+            "prefill.logits.in": "q9j_prefill.logits.in",   # new
+        }
+        for stream, dct in _q9j_buf.items():
+            if not dct:
+                continue
+            stem = _q9j_os.path.join(_Q9J_CAPTURE_DIR, STREAM_TO_FILE[stream])
+            p = _q9j_save_dict(dct, stem)
+            print(f"[Q9j] saved {stream}: {len(dct)} cells -> {p}")
+        if _q9j_prefill_buf:
+            stem = _q9j_os.path.join(_Q9J_CAPTURE_DIR, "q9j_prefill.topk.out")
+            p = _q9j_save_dict(_q9j_prefill_buf, stem)
+            print(f"[Q9j] saved prefill.topk.out: {len(_q9j_prefill_buf)} layers -> {p}")
+    else:
+        # per-layer: <dir>/layer_<L>/<stream>.<ext>
+        # Reverse-index: group every buf entry by layer.
+        STREAM_NAME = {
+            "logits.in":         "decode.logits.in",
+            "preidx.in":         "decode.preidx.in",
+            "topk.out":          "decode.topk.out",
+            "prefill.logits.in": "prefill.logits.in",
+        }
+        per_layer_streams = {}  # {layer: {stream_name: {step|chunk: tensor}}}
+        for stream, dct in _q9j_buf.items():
+            for (layer, sub), tensor in dct.items():
+                per_layer_streams.setdefault(layer, {}).setdefault(
+                    STREAM_NAME[stream], {})[sub] = tensor
+        # Legacy prefill topk: also into per-layer tree
+        for layer, tensor in _q9j_prefill_buf.items():
+            per_layer_streams.setdefault(layer, {})["prefill.topk.out"] = tensor
+        # Flush
+        total_files = 0
+        for layer in sorted(per_layer_streams):
+            ldir = _q9j_os.path.join(_Q9J_CAPTURE_DIR, f"layer_{layer:02d}")
+            _q9j_os.makedirs(ldir, exist_ok=True)
+            for stream_name, payload in per_layer_streams[layer].items():
+                stem = _q9j_os.path.join(ldir, stream_name)
+                if isinstance(payload, dict):
+                    p = _q9j_save_dict(payload, stem)
+                    n = len(payload)
+                else:
+                    # Scalar tensor (e.g. prefill.topk.out per layer)
+                    if _Q9J_FORMAT == "pt":
+                        p = stem + ".pt"
+                        torch.save(payload, p)
+                    else:
+                        import numpy as _np
+                        p = stem + ".npy"
+                        _np.save(p, payload.numpy())
+                    n = 1
+                print(f"[Q9j] L{layer:02d} {stream_name}: {n} -> {p}")
+                total_files += 1
+        print(f"[Q9j] per-layer flush done: {len(per_layer_streams)} layers, "
+              f"{total_files} files under {_Q9J_CAPTURE_DIR}")
+
+    _q9j_state["flushed"] = True
+
+
+if _Q9J_CAPTURE_DIR:
+    _q9j_atexit.register(_q9j_flush)
+    print(
+        f"[Q9j] capture ENABLED. dir={_Q9J_CAPTURE_DIR} "
+        f"layers={_Q9J_LAYERS_TO_LOG} phase={_Q9J_PHASE} "
+        f"layout={_Q9J_LAYOUT} format={_Q9J_FORMAT}",
+        flush=True,
+    )
+# === End Q9j capture hook v2 =================================================
